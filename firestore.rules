rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == "abdullahcheemakv@gmail.com";
    }

    function isAdmin() {
      return signedIn() && (
        isOwner()
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        )
      );
    }

    match /games/{gameId} {
      allow get, list: if true;
      allow create: if isOwner()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner();
    }

    match /admins/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    // Private one-to-one conversations. Users can access only their own UID path.
    match /privateConversations/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'userName', 'userEmail', 'createdAt',
          'lastMessage', 'lastMessageAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 40
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 254
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() >= 1
        && request.resource.data.lastMessage.size() <= 140;

      allow update: if signedIn() && (
        (
          request.auth.uid == userId
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 140
        )
        ||
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'lastMessage', 'lastMessageAt',
              'pinnedMessageId', 'pinnedText', 'pinnedAt', 'pinnedBy'
            ])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinnedBy'])
            || request.resource.data.pinnedBy == request.auth.uid
          )
        )
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentConversationExists() {
          return exists(/databases/$(database)/documents/privateConversations/$(userId));
        }

        function isConversationMember() {
          return signedIn()
            && request.auth.uid == userId
            && parentConversationExists()
            && get(/databases/$(database)/documents/privateConversations/$(userId)).data.ownerUid == request.auth.uid;
        }

        allow get, list: if isConversationMember() || isAdmin();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'text', 'authorUid', 'authorName', 'role', 'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1500
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() >= 1
          && request.resource.data.authorName.size() <= 40
          && (
            (isConversationMember() && request.resource.data.role == 'member')
            || (isAdmin() && parentConversationExists() && request.resource.data.role == 'admin')
          );

        allow update, delete: if isAdmin();
      }
    }

    // Signed-in members can read the public community chat and create messages as themselves.
    // Public posts are immutable from clients; only the author identity and bounded text are accepted.
    match /supportPublicMessages/{messageId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'text', 'authorUid', 'authorName', 'role', 'createdAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.createdAt is timestamp
        && (
          (isAdmin() && request.resource.data.role == 'admin')
          || (!isAdmin() && request.resource.data.role == 'member')
        );

      allow update, delete: if false;
    }

    // Legacy public support posts remain disabled; the new public chat uses supportPublicMessages.
    match /supportPosts/{postId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}