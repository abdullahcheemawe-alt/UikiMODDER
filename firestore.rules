rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "abdullahcheemakv@gmail.com";
    }

    function isAdmin() {
      return request.auth != null
        && (isOwner()
          || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true));
    }

    match /games/{gameId} {
      allow get, list: if true;
      allow create: if isOwner()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // Public profile-free admin membership lookup; only owner manages roles.
    match /admins/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    // Community support posts are public to read. Signed-in members can create
    // their own report. Only admins can change issue status.
    match /supportPosts/{postId} {
      allow get, list: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'message', 'authorUid',
          'authorName', 'status', 'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 90
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 700
        && request.resource.data.category in [
          'Bug Report', 'Download Issue', 'Account Help', 'Suggestion', 'Other'
        ]
        && request.resource.data.status == 'open'
        ;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'resolved'];

      allow delete: if isAdmin();

      match /replies/{replyId} {
        allow get, list: if true;

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly([
            'message', 'authorUid', 'authorName', 'role', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 400
          && request.resource.data.role == (isAdmin() ? 'admin' : 'member');

        allow update, delete: if isAdmin();
      }
    }

    // All unrelated collections remain closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}