rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() { return request.auth != null && request.auth.token.email == "abdullahcheemakv@gmail.com"; }
  match /games/{gameId} {
   allow read: if true;
   allow create: if isAdmin() && request.resource.data.name is string && request.resource.data.description is string && request.resource.data.type in ["game","app"] && request.resource.data.published == true;
   allow update, delete: if isAdmin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}