rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email == "abdullahcheemakv@gmail.com";
    }
    function isAdmin() {
      return signedIn() && (isOwner()
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true));
    }

    match /games/{gameId} {
      allow get, list: if true;
      allow create: if isOwner() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner();
    }

    match /admins/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    // Minimal member directory: searchable names only, no email addresses.
    match /users/{userId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40;
      allow delete: if request.auth.uid == userId || isOwner();
    }

    // One private direct chat per pair of users.
    match /directChats/{chatId} {
      allow get, list: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participants', 'participantNames', 'createdAt', 'lastMessage', 'lastMessageAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participantNames is map
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 140;
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt']);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function isChatMember() {
          return signedIn()
            && get(/databases/$(database)/documents/directChats/$(chatId)).data.participants
              .hasAny([request.auth.uid]);
        }
        allow get, list: if isChatMember();
        allow create: if isChatMember()
          && request.resource.data.keys().hasOnly([
            'text', 'senderUid', 'senderName', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1500;
        allow update, delete: if false;
      }
    }

    // Legacy Contact Owner conversations remain private and available.
    match /privateConversations/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageAt', 'pinnedMessageId', 'pinnedText', 'pinnedAt', 'pinnedBy'
          ]))
      );
      allow delete: if isAdmin();
      match /messages/{messageId} {
        function conversationOwner() {
          return signedIn()
            && get(/databases/$(database)/documents/privateConversations/$(userId)).data.ownerUid == request.auth.uid;
        }
        allow get, list: if conversationOwner() || isAdmin();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1500
          && ((conversationOwner() && request.resource.data.role == 'member')
            || (isAdmin() && request.resource.data.role == 'admin'));
        allow update, delete: if isAdmin();
      }
    }

    match /supportPosts/{postId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}