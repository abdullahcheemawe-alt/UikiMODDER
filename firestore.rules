rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "abdullahcheemakv@gmail.com";
    }

    function isAdmin() {
      return request.auth != null
        && (isOwner()
          || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true));
    }

    match /games/{gameId} {
      allow get, list: if true;
      allow create: if isOwner()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner();
    }

    match /admins/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    // Private one-to-one conversations: the user and admins only.
    match /privateConversations/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'userName', 'userEmail', 'createdAt',
          'lastMessage', 'lastMessageAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 40
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 140;

      allow update: if request.auth != null && (
        (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt'])
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        ||
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'lastMessage', 'lastMessageAt',
              'pinnedMessageId', 'pinnedText', 'pinnedAt', 'pinnedBy'
            ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinnedBy'])
            || request.resource.data.pinnedBy == request.auth.uid
          )
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function conversationOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/privateConversations/$(userId)).data.ownerUid == request.auth.uid;
        }

        allow get, list: if conversationOwner() || isAdmin();

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly([
            'text', 'authorUid', 'authorName', 'role', 'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1500
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40
          && (
            (conversationOwner() && request.resource.data.role == 'member')
            || (isAdmin() && request.resource.data.role == 'admin')
          );

        allow update, delete: if isAdmin();
      }
    }

    // Previous public board is no longer used by the website.
    match /supportPosts/{postId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}